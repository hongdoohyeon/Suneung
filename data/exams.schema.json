{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exams",
  "description": "기출 시험 메타데이터 카탈로그. data/exams.json 의 스키마.",
  "type": "array",
  "items": {
    "$ref": "#/definitions/Exam"
  },
  "definitions": {
    "Exam": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "curriculum",
        "gradeYear",
        "examYear",
        "month",
        "typeGroup",
        "type",
        "subject",
        "subSubject",
        "solutionUrl",
        "questionUrl",
        "answerUrl"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "전역 유니크 식별자."
        },
        "curriculum": {
          "type": "string",
          "enum": [
            "2015",
            "2009",
            "2007개정",
            "7차",
            "6차",
            "사관",
            "경찰대",
            "LEET",
            "MEET",
            "예비",
            "pre2009",
            "논술",
            "reference",
            "초졸",
            "중졸",
            "고졸"
          ],
          "description": "교육과정 또는 시험군. 수능은 2015/2009/2007개정/7차/6차, 그 외는 시험명. 'pre2009'는 옛 통합 키로 호환용."
        },
        "gradeYear": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 9999,
          "description": "학년도 (예: 2026학년도 수능). 9999는 reference(통계자료)."
        },
        "examYear": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100,
          "description": "실제 시험 시행 연도."
        },
        "month": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "description": "시행 월. 0은 시기 미상(예비/reference)."
        },
        "typeGroup": {
          "type": "string",
          "enum": [
            "education",
            "suneung",
            "military",
            "police",
            "leet",
            "meet",
            "essay",
            "reference",
            "ged"
          ],
          "description": "시험 카테고리(상위). essay는 대학별 논술, reference는 통계 PDF."
        },
        "type": {
          "type": "string",
          "enum": [
            "csat",
            "june",
            "sept",
            "mar",
            "apr",
            "may",
            "jun",
            "jul",
            "sep",
            "oct",
            "nov",
            "dec",
            "prelim",
            "stat",
            "leet_annual",
            "meet_annual",
            "essay_annual",
            "essay_mock",
            "military_annual",
            "police_annual",
            "ged_1",
            "ged_2"
          ],
          "description": "시험 회차/시기(하위). jun/sep/nov/dec는 고1·고2 학평. stat은 통계."
        },
        "studentGrade": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            0,
            1,
            2,
            3,
            null
          ],
          "description": "학평 학년 (1=고1, 2=고2, 3=고3). 0은 reference·N수생."
        },
        "subject": {
          "type": "string",
          "description": "영역명. 옛 수능 ‘인문계/자연계/예체능계’ 및 reference 자료 포함."
        },
        "subSubject": {
          "type": [
            "string",
            "null"
          ],
          "description": "탐구 영역 세부 과목 또는 가/나형 등. 해당 없으면 null."
        },
        "solutionUrl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "해설 PDF URL."
        },
        "solutionDownload": {
          "type": [
            "string",
            "null"
          ]
        },
        "solutionSource": {
          "type": [
            "string",
            "null"
          ],
          "description": "해설 문서 발행·제공 출처."
        },
        "solutionSourcePage": {
          "type": [
            "string",
            "null"
          ],
          "description": "해설 문서를 확인한 공식 목록 페이지."
        },
        "questionUrl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "문제지 PDF URL. 없을 수 있음(옛 학평 일부는 정답/해설만 수집됨)."
        },
        "answerUrl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "정답 PDF URL. 없을 수 있음(예: 논술)."
        },
        "answerIncludesSolution": {
          "type": "boolean",
          "description": "answerUrl 문서가 단순 정답표가 아니라 문항별 해설까지 포함하면 true."
        },
        "questionDownload": {
          "type": [
            "string",
            "null"
          ]
        },
        "answerDownload": {
          "type": [
            "string",
            "null"
          ]
        },
        "listenUrl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "영어 듣기 mp3 URL."
        },
        "listenDownload": {
          "type": [
            "string",
            "null"
          ]
        },
        "scriptUrl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "영어 듣기 대본 PDF URL."
        },
        "scriptDownload": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "description": "원본 출처 태그 (kice-archive 등)."
        }
      }
    }
  }
}

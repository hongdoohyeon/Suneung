#!/usr/bin/env python3
"""모든 answerUrl 가진 정답표 PDF 를 probe → 2페이지(1p 홀수, 2p 짝수) 패턴이면 분리.

산출:
  tmp/even-answers/{id}_a_even.pdf — 짝수 정답표 (p2만 추출)
  data/even-form-overrides.json (append) — answerUrlEven attach
"""
from __future__ import annotations
import json, urllib.request, subprocess, tempfile, os
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from pypdf import PdfReader, PdfWriter

UA = {'User-Agent': 'Mozilla/5.0'}
OUT = Path('tmp/even-answers')
OUT.mkdir(parents=True, exist_ok=True)

ITEMS = json.load(open('data/exams-v2.json'))
# 대상: typeGroup=suneung, answerUrl 있음, 1994~2026 범위
candidates = [i for i in ITEMS if i.get('typeGroup')=='suneung' and i.get('answerUrl')]
print(f'▣ 대상 candidates: {len(candidates)}')


def probe_and_split(it):
    """answerUrl 다운 → 페이지 분석 → 2p (홀,짝) 패턴이면 odd/even 둘 다 분리."""
    url = it['answerUrl']
    out_odd  = OUT / f"{it['id']}_a_odd.pdf"
    out_path = OUT / f"{it['id']}_a_even.pdf"
    if out_path.exists() and out_odd.exists():
        return it['id'], 'cached', str(out_path)
    try:
        req = urllib.request.Request(url, headers=UA)
        data = urllib.request.urlopen(req, timeout=30).read()
        with tempfile.NamedTemporaryFile(suffix='.pdf', delete=False) as tf:
            tf.write(data); path = tf.name

        info = subprocess.run(['pdfinfo', path], capture_output=True, text=True).stdout
        try:
            pages = next(int(l.split(':')[1].strip()) for l in info.splitlines() if l.startswith('Pages:'))
        except StopIteration:
            os.unlink(path); return it['id'], 'no_pages', None

        if pages != 2:
            os.unlink(path); return it['id'], f'pages={pages}', None

        # 페이지별 텍스트 표기 확인
        t1 = subprocess.run(['pdftotext', '-layout', '-f', '1', '-l', '1', path, '-'],
                            capture_output=True, text=True).stdout
        t2 = subprocess.run(['pdftotext', '-layout', '-f', '2', '-l', '2', path, '-'],
                            capture_output=True, text=True).stdout
        has_odd = '홀수' in t1
        has_even = '짝수' in t2
        if not (has_odd and has_even):
            os.unlink(path); return it['id'], 'no_odd_even_marker', None

        # pypdf 로 page1(홀수) / page2(짝수) 둘 다 분리
        reader = PdfReader(path)
        # odd
        w = PdfWriter(); w.add_page(reader.pages[0])
        with open(out_odd, 'wb') as fout: w.write(fout)
        # even
        w = PdfWriter(); w.add_page(reader.pages[1])
        with open(out_path, 'wb') as fout: w.write(fout)
        os.unlink(path)
        return it['id'], 'split', (str(out_odd), str(out_path))
    except Exception as ex:
        return it['id'], f'err:{type(ex).__name__}', None


results = {'split': 0, 'pages=1': 0, 'no_odd_even_marker': 0, 'err': 0, 'cached': 0, 'other': 0}
splits = []
with ThreadPoolExecutor(max_workers=8) as ex:
    futs = {ex.submit(probe_and_split, it): it for it in candidates}
    done = 0
    for fut in as_completed(futs):
        id_, status, path = fut.result()
        done += 1
        if status == 'split': results['split'] += 1; splits.append((id_, path))
        elif status == 'pages=1': results['pages=1'] += 1
        elif status == 'no_odd_even_marker': results['no_odd_even_marker'] += 1
        elif status.startswith('err'): results['err'] += 1
        elif status == 'cached': results['cached'] += 1; splits.append((id_, path))
        else: results['other'] += 1
        if done % 50 == 0:
            print(f'  진행 {done}/{len(candidates)} — {results}')

print(f'\n▣ 결과: {results}')
print(f'  분리 완료: {len(splits)}건 → {OUT}')

# overrides 추가 — 기존 even-form-overrides.json 에 answerUrlEven 합치기
OV_PATH = Path('data/even-form-overrides.json')
existing = json.loads(OV_PATH.read_text(encoding='utf-8')) if OV_PATH.exists() else []
REL_BASE = 'https://suneung-files.hdh061224.workers.dev/kice-archive-v3/'

# id 기반 빠른 lookup 으로 추가 — match 는 item 의 (gy,type,subject,subSubject) 사용
id_to_item = {i['id']: i for i in ITEMS}
new_count = 0
existing_set = set()  # 중복 회피 (gradeYear, type, subject, subSubject) 키
for ov in existing:
    m = ov.get('match', {})
    existing_set.add((m.get('gradeYear'), m.get('type'), m.get('subject'), m.get('subSubject'), 'a' if 'answerUrlEven' in ov else 'q'))

for id_, _ in splits:
    it = id_to_item.get(id_)
    if not it: continue
    key = (it.get('gradeYear'), it.get('type'), it.get('subject'), it.get('subSubject'), 'a')
    if key in existing_set: continue
    even_name = f"{it['gradeYear']}_{it['type']}_id{id_}_a_even.pdf"
    odd_name  = f"{it['gradeYear']}_{it['type']}_id{id_}_a_odd.pdf"
    existing.append({
        'match': {
            'gradeYear': it.get('gradeYear'), 'type': it.get('type'),
            'subject': it.get('subject'), 'subSubject': it.get('subSubject'),
        },
        'answerUrl':       REL_BASE + odd_name,    # 홀수 분리본으로 기존 url 대체
        'answerDownload':  f"{it.get('gradeYear')}학년도_{it.get('type')}_{it.get('subject')}_{it.get('subSubject') or ''}_정답(홀수형).pdf".replace('__', '_'),
        'answerUrlEven':   REL_BASE + even_name,
        'answerDownloadEven': f"{it.get('gradeYear')}학년도_{it.get('type')}_{it.get('subject')}_{it.get('subSubject') or ''}_정답(짝수형).pdf".replace('__', '_'),
        '_split_local_odd':  str(OUT / odd_name),
        '_split_local_even': str(OUT / even_name),
        '_target_odd':  odd_name,
        '_target_even': even_name,
    })
    new_count += 1
    existing_set.add(key)

OV_PATH.write_text(json.dumps(existing, ensure_ascii=False, indent=2), encoding='utf-8')
print(f'  + {new_count} answerUrlEven overrides 추가 (총 {len(existing)} entries)')
